#!/bin/sh
# Git pre-commit hook: enforces compilation and automated test suites pass cleanly before commit

echo "Running pre-commit test checks..."

# 1. Frontend tests
if [ -d "sssp-frontend" ]; then
  echo "Checking frontend tests..."
  (cd sssp-frontend && npm test -- --watchAll=false) || {
    echo "Frontend tests failed. Aborting commit."
    exit 1
  }
fi

# 2. Backend tests
if [ -d "sssp-backend" ]; then
  echo "Checking backend compilation and tests..."
  (cd sssp-backend && JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home ./mvnw test -q) || {
    echo "Backend test verification failed. Aborting commit."
    exit 1
  }
fi

echo "Pre-commit checks passed successfully."
exit 0
